      "isDeleted": false,
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "KEY INSIGHT: VNet peering is NON-TRANSITIVE.\nSpoke1 <-> Hub and Spoke2 <-> Hub, but Spoke1 CANNOT reach Spoke2 directly. Use NVA + UDRs.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "insight_box",
      "originalText": "KEY INSIGHT: VNet peering is NON-TRANSITIVE.\nSpoke1 <-> Hub and Spoke2 <-> Hub, but Spoke1 CANNOT reach Spoke2 directly. Use NVA + UDRs."
    }
